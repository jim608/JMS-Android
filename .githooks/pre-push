#!/bin/sh
set -eu
case "$2" in
    *DonutWare/Fladder*) echo 'Official upstream is read-only.' >&2; exit 1 ;;
esac
if [ -x .jms-tools/python/Scripts/python.exe ]; then
    jms_python=.jms-tools/python/Scripts/python.exe
else
    jms_python=python3
fi
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    case "$remote_ref" in
        refs/heads/jms|refs/tags/*) ;;
        *) echo 'JMS pushes may only update jms or release tags.' >&2; exit 1 ;;
    esac
    case "$remote_oid" in
        0000000000000000000000000000000000000000)
            # A release tag may identify an earlier, already published jms
            # build while newer publication tooling is pushed on the branch.
            case "$remote_ref" in
                refs/tags/*)
                    published=$(git ls-remote "$2" refs/heads/jms | cut -f1)
                    if [ -n "$published" ]; then
                        git fetch --quiet --no-tags "$2" refs/heads/jms >/dev/null 2>&1
                        if ! git merge-base --is-ancestor "$published" "$local_oid"; then
                            git merge-base --is-ancestor "$local_oid" "$published"
                        fi
                        "$jms_python" scripts/check_jms_git_privacy.py --outgoing "$local_oid" --base "$published"
                        "$jms_python" scripts/check_jms_git_privacy.py --tree "$local_oid"
                        continue
                    fi ;;
            esac
            base=$(git ls-remote "$2" refs/heads/main | cut -f1)
            if [ -n "$base" ]; then
                git fetch --quiet --no-tags "$2" refs/heads/main >/dev/null 2>&1
                git merge-base --is-ancestor "$base" "$local_oid"
                "$jms_python" scripts/check_jms_git_privacy.py --outgoing "$local_oid" --base "$base"
            else
                "$jms_python" scripts/check_jms_git_privacy.py --outgoing "$local_oid"
            fi ;;
        *)
            git fetch --quiet --no-tags "$2" "$remote_ref" >/dev/null 2>&1
            git merge-base --is-ancestor "$remote_oid" "$local_oid"
            "$jms_python" scripts/check_jms_git_privacy.py --outgoing "$local_oid" --base "$remote_oid" ;;
    esac
    "$jms_python" scripts/check_jms_git_privacy.py --tree "$local_oid"
done
