FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS toolchain
ENV FLUTTER_SUPPRESS_ANALYTICS=true PUB_CACHE=/opt/pub-cache PATH=/opt/flutter/bin:${PATH}
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git unzip xz-utils zip clang cmake ninja-build pkg-config \
    libgtk-3-dev libstdc++-12-dev liblzma-dev libmpv-dev libmimalloc-dev \
    libasound2-dev libsqlite3-dev python3 dpkg-dev xvfb xauth dbus-x11 && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 3.35.7 https://github.com/flutter/flutter.git /opt/flutter && \
    test "$(git -C /opt/flutter rev-parse HEAD)" = adc901062556672b4138e18a4dc62a4be8f4b3c2 && \
    flutter precache --linux
WORKDIR /workspace

FROM toolchain AS build
ARG JMS_BUILD_ID=LOCAL-UNSTAMPED
COPY . .
RUN flutter pub get --enforce-lockfile && flutter build linux --release --no-pub \
    --dart-define="JMS_BUILD_ID=$JMS_BUILD_ID"
RUN ! find build/linux/x64/release/bundle -iname '*mdk*' -o -iname '*fvp*' | grep .

FROM scratch AS export
COPY --from=build /workspace/build/linux/x64/release/bundle/ /bundle/

FROM build AS package
ARG JMS_SOURCE_COMMIT
ARG JMS_BUILD_ID
RUN python3 scripts/package_jms_linux.py --source-commit "$JMS_SOURCE_COMMIT" --build-id "$JMS_BUILD_ID"
